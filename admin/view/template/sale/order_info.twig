    // Common function to handle all button clicks
    function prepareOrder(order_status_id) {
        $.ajax({
            url: '{{ catalog }}index.php?route=api/order/history&api_token={{ api_token }}&store_id={{ store_id }}&order_id={{ order_id }}',
            type: 'post',
            dataType: 'json',
            data: 'order_status_id=' + encodeURIComponent(order_status_id) + 
                  '&notify=' + ($('input[name=\'notify\']').prop('checked') ? 1 : 0) +
                  '&override=' + ($('input[name=\'override\']').prop('checked') ? 1 : 0) +
                  '&append=' + ($('input[name=\'append\']').prop('checked') ? 1 : 0) + 
                  '&comment=' + encodeURIComponent($('textarea[name=\'comment\']').val()),
            beforeSend: function() {
                $('#button-history').button('loading');
            },
            complete: function() {
                $('#button-history').button('reset');
            },
            success: function(json) {
                $('.alert-dismissible').remove();
    
                if (json['error']) {
                    $('#history').before('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                }
    
                if (json['success']) {
                    $('#history').load('index.php?route=sale/order/history&user_token={{ user_token }}&order_id={{ order_id }}');
    
                    $('#history').before('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
    
                    $('textarea[name=\'comment\']').val(''); // Clear the comment field
                    // Reload the page after successful operation
                    location.reload();
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    }
  
  // Handle "Customer Request" button click event
function getQueryParam(param) {
    let urlParams = new URLSearchParams(window.location.search);
    return urlParams.get(param);
}

// Get the order_id from the URL
let order_id = getQueryParam('order_id');

// Handle "Customer Request" button click event
$('#customerRequestButton').on('click', function(event) {
    event.preventDefault(); // Prevent default action of the anchor tag

    // Get the user token from the URL
    let user_token = getQueryParam('user_token');

    // Construct the URL with the selected order ID
    let url = 'index.php?route=sale/order/customer_request&user_token=' + encodeURIComponent(user_token) + '&order_id=' + encodeURIComponent(order_id);
    
    // Redirect to the constructed URL
    location.href = url;
});

       
