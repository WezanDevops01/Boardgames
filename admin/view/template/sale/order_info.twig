		 <div class="col-md-4 col-12 button-container">
			<button type="button" class="btn btn-danger remove_order_id" data-toggle="modal" data-target="#RemoveModal">Remove Linked orders</button>
			<button type="button" class="btn btn-primary add_order_id" data-toggle="modal" data-target="#exampleModal">Add Linked orders</button>
		</div>
	</div>

	<div class="modal fade" id="RemoveModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="exampleModalLabel">Removed Linked Order Id</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body">
					<form id="orderForm">
						<div class="form-group">
							<label for="RemoveInputField">Order ID</label>
							<input type="text" class="form-control" id="RemoveInputField" placeholder="Enter order ID(s), separated by commas">
						</div>
						<button type="button" class="btn btn-primary" id="submitRemoveOrder">Submit</button>
					</form>
				</div>
			</div>
		</div>
	</div>

	<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="exampleModalLabel">Linked Order Id</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body">
					<form id="orderForm">
						<div class="form-group">
							<label for="inputField">Order ID</label>
							<input type="text" class="form-control" id="inputField" value="" placeholder="Enter order ID(s), separated by commas">
						</div>
						<button type="button" class="btn btn-primary" id="submitOrderForm">Submit</button>
					</form>
				</div>
			</div>
		</div>
	</div>
      <div class="panel-body">
           <script type="text/javascript">
$(document).ready(function() {
  $('#submitOrderForm').on('click', function() {
    var linkedOrderIds = $('#inputField').val();
    console.log('Sending data:', linkedOrderIds);
    $('#exampleModal').modal('hide');
    $.ajax({
      url: 'index.php?route=sale/order/info&user_token={{ user_token }}&order_id={{ order_id }}',
      type: 'POST',
      data: {
        linked_order_ids: linkedOrderIds
      },
      dataType: 'json',
      success: function(response) {
        if (response.success) {
          console.log('Linked orders added successfully');
          $('#inputField').val('');
          location.reload();
          showMessage('Linked orders added successfully', 'success');
        } else {
          console.log('Error adding linked orders');
          location.reload();
          showMessage(response.message, 'danger');
        }
      },
      error: function(xhr, status, error) {
       // console.log('AJAX Error:', status, error);
        showMessage('An error occurred while processing your request.', 'danger');
      }
    });
  });
  
 $('#submitRemoveOrder').on('click', function() {
    var linkedOrderIds = $('#RemoveInputField').val();
    console.log('Sending data:', linkedOrderIds);
    $('#RemoveModal').modal('hide');
    $.ajax({
        url: 'index.php?route=sale/order/deleteLinkOrder&user_token={{ user_token }}&order_id={{ order_id }}',
        type: 'POST',
        data: {
            linked_order_ids: linkedOrderIds,
            order_id: {{ order_id }}
        },
        dataType: 'json',
        success: function(response) {
            console.log('Response:', response);
            if (response.success) {
                $('#RemoveInputField').val('');
                location.reload();
                showMessage(response.message, 'success');
            } else {
                showMessage(response.message || 'Unknown error occurred', 'danger');
            }
        },
        error: function(xhr, status, error) {
            console.log('AJAX Error:', status, error);
            console.log('Response Text:', xhr.responseText);
            showMessage('An error occurred while processing your request. Please check the console for details.', 'danger');
        }
    });
});


  function showMessage(message, type) {
    var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    var html = '<div class="alert ' + alertClass + ' alert-dismissible" role="alert">' +
               '<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>' +
               message +
               '</div>';
    $('#message-container').html(html);
  }
});
</script>

