<script>
    document.addEventListener("DOMContentLoaded", function() {
        var addressElement = document.getElementById('mapLink');
        var addressHTML = addressElement.innerHTML;

        // Remove any text before the first <br> tag
        var indexOfFirstBr = addressHTML.indexOf('<br');
        if (indexOfFirstBr !== -1) {
            addressHTML = addressHTML.substring(indexOfFirstBr);
        }

        // Replace <br> with + for URL
        var formattedAddressForUrl = addressHTML.replace(/<br\s*\/?>/gi, '+').replace(/<\/?[^>]+>/gi, '');

        // Create the Google Maps URL
        var mapUrl = "https://www.google.com/maps?q=" + encodeURIComponent(formattedAddressForUrl);
        addressElement.href = mapUrl;

        // Format address for display
        var formattedAddressForDisplay = addressHTML.replace(/<br\s*\/?>/gi, '<br>').replace(/<\/?[^>]+>/gi, '');
        
        // Update display address span
        var displayAddressElement = document.getElementById('displayAddress');
        displayAddressElement.innerHTML = formattedAddressForDisplay;
    });

function copyToClipboard(text, buttonId) {
  navigator.clipboard.writeText(text).then(function() {
    var button = document.getElementById(buttonId);
    var originalTitle = button.getAttribute('data-original-title');
    
    // Change the tooltip text
    button.setAttribute('data-original-title', 'Copied!');
    
    // Trigger the tooltip
    $(button).tooltip('show');
    
    // Reset the tooltip text and hide it after 2 seconds
    setTimeout(function() {
      button.setAttribute('data-original-title', originalTitle);
      $(button).tooltip('hide');
    }, 2000);
  }, function(err) {
    console.error('Could not copy text: ', err);
  });
}

// Initialize tooltips
$(function () {
  $('[data-toggle="tooltip"]').tooltip();
});
</script>
