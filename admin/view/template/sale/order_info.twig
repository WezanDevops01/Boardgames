<script>
(function() {
  function autoBindShippingLogic() {
    const courierSelect = document.getElementById('courier_select');
    const shipmentStatus = document.getElementById('shipped_order_status');
    const orderStatus = document.getElementById('input-order-status');

    // If not found yet, return false so we keep watching
    if (!courierSelect || !shipmentStatus || !orderStatus) {
      return false;
    }

    // Add event listener for Shipping Partner
    courierSelect.addEventListener('change', function () {
      const selectedText = courierSelect.options[courierSelect.selectedIndex].text.trim();

      if (selectedText === 'Local Pickup') {
        shipmentStatus.value = '20'; // Pickup Ready
        orderStatus.value = '20';
      } else if (selectedText === 'Local Delivery') {
        shipmentStatus.value = '21'; // Delivery Ready
        orderStatus.value = '21';
      } else if (selectedText !== '-- PLEASE SELECT --') {
        shipmentStatus.value = '3';  // Shipped
        orderStatus.value = '3';
      }
    });

    // Add event listener for Shipment Status
    shipmentStatus.addEventListener('change', function () {
      const val = shipmentStatus.value;
      if (['20', '21', '3'].includes(val)) {
        orderStatus.value = val;
      }
    });

    return true; // successfully bound
  }

  // Start observing the DOM for the elements to appear
  const observer = new MutationObserver(function(mutations, obs) {
    if (autoBindShippingLogic()) {
      obs.disconnect(); // Stop watching once bound
    }
  });

  // Start watching the whole document body
  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
})();
</script>
