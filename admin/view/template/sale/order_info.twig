	  	  <script>
		// ----------------------------------------------
	// Save Size & Weight (Inline, No Popup)
	// ----------------------------------------------
	$('#saveInlineSizeWeight').on('click', function () {

		var order_id = {{ order_id }};
		var weight = $('#global_weight_kg').val();
		var l = $('#global_size_l').val();
		var w = $('#global_size_w').val();
		var h = $('#global_size_h').val();

		$.ajax({
			url: 'index.php?route=sale/order/saveGlobalSizeWeight&user_token={{ user_token }}',
			type: 'post',
			data: {
				order_id: order_id,
				weight_kg: weight,
				size_l: l,
				size_w: w,
				size_h: h
			},
			dataType: 'json',
			success: function (json) {
				if (json.success) {
					location.reload(); // Refresh page after successful save
				}
			}
		});
	});
	</script>
