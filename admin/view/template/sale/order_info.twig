  <script type="text/javascript"> 
$(document).ready(function () {

    // -----------------------------------------
    // 1. On page load → restore saved button colors
    // -----------------------------------------
    $('button[data-order-product-id]').each(function () {
        var id = $(this).data('order-product-id');

        if (localStorage.getItem('size_weight_saved_' + id) === '1') {
            $(this).removeClass('btn-danger').addClass('btn-primary');
        }
    });


    // -----------------------------------------
    // 2. When modal opens → load existing values
    // -----------------------------------------
    $('div.modal').on('show.bs.modal', function (e) {
        var modal = $(this);
        var button = $(e.relatedTarget);
        var order_product_id = button.data('order-product-id');

        $.ajax({
            url: 'index.php?route=sale/order/getProductSizeWeight&user_token={{ user_token }}&order_product_id=' + order_product_id,
            dataType: 'json',
            success: function(json) {
                modal.find('input[name="weight_kg_' + order_product_id + '"]').val(json.weight_kg);
                modal.find('input[name="size_l_' + order_product_id + '"]').val(json.size_l);
                modal.find('input[name="size_w_' + order_product_id + '"]').val(json.size_w);
                modal.find('input[name="size_h_' + order_product_id + '"]').val(json.size_h);
            }
        });
    });


    // -----------------------------------------
    // 3. Save button
    // -----------------------------------------
    $(document).on('click', '.save-size-weight', function () {
        var order_product_id = $(this).data('order-product-id');

        var weight = $('input[name="weight_kg_' + order_product_id + '"]').val();
        var size_l = $('input[name="size_l_' + order_product_id + '"]').val();
        var size_w = $('input[name="size_w_' + order_product_id + '"]').val();
        var size_h = $('input[name="size_h_' + order_product_id + '"]').val();

        $.ajax({
            url: 'index.php?route=sale/order/saveProductSizeWeight&user_token={{ user_token }}',
            type: 'POST',
            dataType: 'json',
            data: {
                order_product_id: order_product_id,
                weight_kg: weight,
                size_l: size_l,
                size_w: size_w,
                size_h: size_h
            },
            success: function (json) {
                if (json.success) {

                    // -----------------------------------------
                    // 🔥 4. Save blue-button flag to localStorage
                    // -----------------------------------------
                    localStorage.setItem('size_weight_saved_' + order_product_id, '1');

                    // Change color instantly
                    $('button[data-order-product-id="' + order_product_id + '"]')
                        .removeClass('btn-danger')
                        .addClass('btn-primary');

                    $('#sizeWeightModal_' + order_product_id).modal('hide');

                    // Refresh page
                    location.reload();
                } else if (json.error) {
                    alert(json.error);
                }
            },
            error: function () {
                alert("Something went wrong while saving.");
            }
        });
    });

});
</script>

