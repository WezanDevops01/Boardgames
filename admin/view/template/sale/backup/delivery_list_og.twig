{{ header }}{{ column_left }}
<div id="content">
<div class="page-header">
  <div class="container-fluid">

    <h1>{{ heading_title }}</h1>
    <ul class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>
  </div>
</div>
<div class="container-fluid">{% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="row">
    <div id="filter-order" class="col-md-3 col-md-push-9 col-sm-12 hidden-sm hidden-xs">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3>
        </div>
        <div class="panel-body">
		  <div class="form-group">
            <label class="control-label" for="input-name">Product name</label>
            <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
          </div>
          <div class="form-group">
            <label class="control-label" for="input-order-id">Order id</label>
            <input type="text" name="filter_order_id" value="{{ filter_order_id }}" placeholder="{{ entry_order_id }}" id="input-order-id" class="form-control" />
          </div>
           <div class="form-group">
                <label class="control-label" for="input-order-status">Order Status</label>
               <!-- <input type="text" name="filter_order_status" value="{{ delivery_status }}" placeholder="{{ entry_order_status }}" id="input-order-status" class="form-control" list="delivery_statuses" />
                <datalist id="delivery_statuses">
            	<option value="Complete">
            	<option value="Credited">
            	<option value="Delivered">
            	<option value="Delivery ready">
            	<option value="Exchanged">
            	<option value="Pending">
            	<option value="Pickup Ready">
            	<option value="Refunded">
            	<option value="Shipping Ready">
            	<option value="Waiting for Preorder">
            </datalist> -->
                <select name="filter_order_status" id="input-order-status" class="form-control">
                     <option value="">Select a option</option>
                    <option value="Complete">Complete</option>
                    <option value="Credited">Credited</option>
                    <option value="Delivered">Delivered</option>
                    <option value="Delivery ready">Delivery ready</option>
                    <option value="Exchanged">Exchanged</option>
                    <option value="Pending">Pending</option>
                    <option value="Pickup Ready">Pickup Ready</option>
                    <option value="Refunded">Refunded</option>
                    <option value="Shipping Ready">Shipping Ready</option>
                    <option value="Waiting for Preorder">Waiting for Preorder</option>
                </select>
            </div>

          
          <div class="form-group text-right">
            <button type="button" id="button-filter" class="btn btn-default"><i class="fa fa-filter"></i> {{ button_filter }}</button>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-9 col-md-pull-3 col-sm-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
        </div>
        <div class="panel-body">
          <form method="post" action="" enctype="multipart/form-data" id="form-order">
              <div class="alphabet-filter">
                {% for letter in 'a'..'z' %}
                  <a href="#" class="alphabet-link" data-letter="{{ letter }}">{{ letter|upper }}</a>
                {% endfor%}
            </div>
            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead>
                  <tr>
                    <td class="text-right">{{ column_order_numbers }}</td>
                    <td class="text-left">{{ column_order_status }}</td>
                    <td class="text-left">{{ column_order_products }}</td>
                    <td class="text-right">{{ column_order_productmodel }}</td>
                    <td class="text-left">{{ column_order_productquantity }}</td>
                  </tr>
                </thead>
                <tbody>
                
                {% if orders %}
                {% for order in orders %}
                <tr>
                  <td class="text-center"> 
					{% if order.order_id|length > 0 %}
                    {{ order.order_id|join(', ') }}
                    {% else %}
                    -
                    {% endif %}
                  </td>
                  <td class="text-right">
					{% for delivery_status in delivery_statuses %}
						{% if delivery_status.delivery_status_id == order.delivery_status_id %}						
							{{ delivery_status.name }}
						{% endif %}
					{% endfor %}	
				  </td>
                  <td class="text-left">{{ order.name|raw }}</td>
                  <td class="text-left">{{ order.model }}</td>
                  <td class="text-right">{{ order.quantity }}</td>                  
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="8">{{ text_no_results }}</td>
                </tr>
                {% endif %}
                  </tbody>
                
              </table>
            </div>
          </form>
          <div class="row">
            <div class="col-sm-6 text-left">{{ pagination }}</div>
            <div class="col-sm-6 text-right">{{ results }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	url = '';

	var filter_name = $('input[name=\'filter_name\']').val();

	if (filter_name) {
		url += '&filter_name=' + encodeURIComponent(filter_name);
	}

	var filter_order_id = $('input[name=\'filter_order_id\']').val();

	if (filter_order_id) {
		url += '&filter_order_id=' + encodeURIComponent(filter_order_id);
	}
	
	var filter_order_status = $('input[name=\'filter_order_status\']').val();

	if (filter_order_status) {
		url += '&filter_order_status=' + encodeURIComponent(filter_order_status);
	}
	
	

	location = 'index.php?route=sale/delivery&user_token={{ user_token }}' + url;
});

    var typingTimer;                // Timer identifier
    var doneTypingInterval = 1000;  // Time in milliseconds (2 seconds)

    // Function to handle typing timeout
    function setupTypingTimer() {
        // On keydown, clear the countdown 
        $('input[name=\'filter_name\'], input[name=\'filter_order_id\']').on('keydown', function() {
            clearTimeout(typingTimer);
            typingTimer = setTimeout(doneTyping, doneTypingInterval);
        });
        
        // On change of select, clear the countdown
        $('select[name=\'filter_order_status\']').on('change', function() {
            clearTimeout(typingTimer);
            typingTimer = setTimeout(doneTyping, 100);
        });
    }

    // Initialize the typing timer setup
    setupTypingTimer();

    // Function to execute when typing is done
    function doneTyping() {
        var url = 'index.php?route=sale/delivery&user_token={{ user_token }}';

        var filter_name = $('input[name=\'filter_name\']').val();
        if (filter_name) {
            url += '&filter_name=' + encodeURIComponent(filter_name);
        }

        var filter_order_id = $('input[name=\'filter_order_id\']').val();
        if (filter_order_id) {
            url += '&filter_order_id=' + encodeURIComponent(filter_order_id);
        }

        var filter_order_status = $('select[name=\'filter_order_status\']').val();
        if (filter_order_status) {
            url += '&filter_order_status=' + encodeURIComponent(filter_order_status);
        }

        // Redirect to the constructed URL
        window.location.href = url;
    }

    // Set initial input values based on URL parameters
    var urlParams = new URLSearchParams(window.location.search);
    var initialFilterName = urlParams.get('filter_name');
    if (initialFilterName) {
        $('input[name=\'filter_name\']').val(initialFilterName);
    }

    var initialFilterOrderId = urlParams.get('filter_order_id');
    if (initialFilterOrderId) {
        $('input[name=\'filter_order_id\']').val(initialFilterOrderId);
    }

    var initialFilterOrderStatus = urlParams.get('filter_order_status');
    if (initialFilterOrderStatus) {
        $('select[name=\'filter_order_status\']').val(initialFilterOrderStatus);
    }

//--></script> 
  <script type="text/javascript"><!--
$('input[name=\'filter_name\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['product_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'filter_name\']').val(item['label']);
	}
});
//--></script> 
  
