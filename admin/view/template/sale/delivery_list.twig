  <script>
$(document).ready(function () {
    const baseUrl = 'index.php?route=sale/delivery&user_token={{ user_token }}';
    let timer;

    // ✅ Apply filters and rebuild the URL
	 function applyFilters() {
		let url = baseUrl;

		// ✅ Always include the 3 exclude parameters first
		url += '&exclude_completed=' + ($('#exclude_completed').is(':checked') ? '1' : '0');
		url += '&exclude_refunded=' + ($('#exclude_refunded').is(':checked') ? '1' : '0');
		url += '&exclude_credited=' + ($('#exclude_credited').is(':checked') ? '1' : '0');

		// 🔍 Read all filter values
		const orderId = $('#search-orderid').val();
		const customer = $('#search-customer').val();
		const orderStatusExact = $('select[name="filter_order_status"]').val();
		const orderStatusText = $('input[name="filter_order_status_text"]').val();
		const products = $('#search-products').val();
		const productModel = $('#search-productmodel').val();
		const startDate = $('#filter-start-date').val();
		const endDate = $('#filter-end-date').val();

		// 🔍 Add filters only if not empty
		if (orderId) url += '&filter_order_id=' + encodeURIComponent(orderId);
		if (customer) url += '&filter_customer=' + encodeURIComponent(customer);
		if (orderStatusExact) url += '&filter_order_status=' + encodeURIComponent(orderStatusExact);
		if (orderStatusText) url += '&filter_order_status_text=' + encodeURIComponent(orderStatusText);
		if (products) url += '&filter_products=' + encodeURIComponent(products);
		if (productModel) url += '&filter_productmodel=' + encodeURIComponent(productModel);
		if (startDate) url += '&filter_start_date=' + encodeURIComponent(startDate);
		if (endDate) url += '&filter_end_date=' + encodeURIComponent(endDate);

		// 🔄 Redirect with clean URL
		window.location.href = url;
	}

    // ✅ Button click
    $('#button-filter').on('click', function (e) {
        e.preventDefault();
        applyFilters();
    });

    // ✅ Change exclude checkboxes instantly on click
    $('#exclude_completed, #exclude_refunded, #exclude_credited').on('change', function () {
        const url = new URL(window.location.href);

        // Remove old params
        url.searchParams.delete('exclude_completed');
        url.searchParams.delete('exclude_refunded');
        url.searchParams.delete('exclude_credited');

        // Set new ones
        url.searchParams.set('exclude_completed', $('#exclude_completed').is(':checked') ? '1' : '0');
        url.searchParams.set('exclude_refunded', $('#exclude_refunded').is(':checked') ? '1' : '0');
        url.searchParams.set('exclude_credited', $('#exclude_credited').is(':checked') ? '1' : '0');

        window.location.href = url.toString();
    });

// Date search button
$('#button-date-search').on('click', function(e) {
    e.preventDefault();
    
    var startDate = $('#filter-start-date').val();
    var endDate = $('#filter-end-date').val();

    // Check if end date is set but start date is not
    if (endDate && !startDate) {
        alert('Please select a start date before searching with an end date.'); // Display a simple pop-up alert
        return; // Stop the function from applying the filters
    }

    applyFilters();
});

    // ✅ Auto-submit typing delay
    $('#search-orderid, #search-customer, #search-order-status, #search-products, #search-productmodel').on('keyup', function () {
        clearTimeout(timer);
        timer = setTimeout(applyFilters, 1000);
    });

    // ✅ Clear filters button
     window.clearDateInput = function () {
        // Clear inputs
        $('#search-orderid, #search-customer, #search-order-status, #search-products, #search-productmodel, #filter-start-date, #filter-end-date').val('');

        // Always keep the three exclude parameters as 1
        let url = baseUrl
            + '&exclude_completed=1'
            + '&exclude_refunded=1'
            + '&exclude_credited=1';

        window.location.href = url;
    };

    // ✅ Autocomplete for product name
    $('input[name="filter_name"]').autocomplete({
        source: function (request, response) {
            $.ajax({
                url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
                dataType: 'json',
                success: function (json) {
                    response($.map(json, function (item) {
                        return { label: item['name'], value: item['product_id'] };
                    }));
                }
            });
        },
        select: function (item) {
            $('input[name="filter_name"]').val(item['label']);
        }
    });

    // ✅ Alphabet click handler
    $(document).on('click', '.alphabet-link', function (e) {
        e.preventDefault();
        const letter = $(this).data('letter');

        const params = new URLSearchParams();
        params.set('filter_name', letter);
        params.set('exclude_completed', 1);
        params.set('exclude_refunded', 1);
        params.set('exclude_credited', 1);

        window.location.href = baseUrl + '&' + params.toString();
    });

    // ✅ Datepicker setup
    $('.date').datetimepicker({
        language: '{{ datepicker }}',
        pickTime: false
    });
});
</script>
  <script type="text/javascript">
$('#button-filter').on('click', function() {
	url = '';

	var filter_name = $('input[name=\'filter_name\']').val();

	if (filter_name) {
		url += '&filter_name=' + encodeURIComponent(filter_name);
	}

	var filter_order_id = $('input[name=\'filter_order_id\']').val();

	if (filter_order_id) {
		url += '&filter_order_id=' + encodeURIComponent(filter_order_id);
	}
	
	var filter_order_status = $('input[name=\'filter_order_status\']').val();

	if (filter_order_status) {
		url += '&filter_order_status=' + encodeURIComponent(filter_order_status);
	}
	var filter_order_status_text = $('input[name="filter_order_status_text"]').val();
	if (filter_order_status_text) {
		url += '&filter_order_status_text=' + encodeURIComponent(filter_order_status_text);
	}
	
	

	location = 'index.php?route=sale/delivery&user_token={{ user_token }}' + url;
});

    var typingTimer;                // Timer identifier
    var doneTypingInterval = 1000;  // Time in milliseconds (2 seconds)

    // Function to handle typing timeout
    function setupTypingTimer() {
        // On keydown, clear the countdown 
        $('input[name=\'filter_name\'], input[name=\'filter_order_id\']').on('keydown', function() {
            clearTimeout(typingTimer);
            typingTimer = setTimeout(doneTyping, doneTypingInterval);
        });
        
        // On change of select, clear the countdown
       $('select[name="filter_order_status"]').on('change', function () {
    let value = $(this).val();
    let base = 'index.php?route=sale/delivery&user_token={{ user_token }}';

    // If user selects "Select a option" (empty)
    if (value === '') {
        window.location.href =
            base +
            '&exclude_completed=1&exclude_refunded=1&exclude_credited=1';
        return;
    }

    // If user selects actual status (Complete, Pending, etc)
    window.location.href = base + '&filter_order_status=' + encodeURIComponent(value);
});
    }

    // Initialize the typing timer setup
    setupTypingTimer();

    // Function to execute when typing is done
    function doneTyping() {
        var url = 'index.php?route=sale/delivery&user_token={{ user_token }}';

        var filter_name = $('input[name=\'filter_name\']').val();
        if (filter_name) {
            url += '&filter_name=' + encodeURIComponent(filter_name);
        }

        var filter_order_id = $('input[name=\'filter_order_id\']').val();
        if (filter_order_id) {
            url += '&filter_order_id=' + encodeURIComponent(filter_order_id);
        }

        var filter_order_status = $('select[name=\'filter_order_status\']').val();
        if (filter_order_status) {
            url += '&filter_order_status=' + encodeURIComponent(filter_order_status);
        }

        // Redirect to the constructed URL
        window.location.href = url;
    }

    // Set initial input values based on URL parameters
    var urlParams = new URLSearchParams(window.location.search);
    var initialFilterName = urlParams.get('filter_name');
    if (initialFilterName) {
        $('input[name=\'filter_name\']').val(initialFilterName);
    }

    var initialFilterOrderId = urlParams.get('filter_order_id');
    if (initialFilterOrderId) {
        $('input[name=\'filter_order_id\']').val(initialFilterOrderId);
    }

    var initialFilterOrderStatus = urlParams.get('filter_order_status');
    if (initialFilterOrderStatus) {
        $('select[name=\'filter_order_status\']').val(initialFilterOrderStatus);
    }

</script> 
