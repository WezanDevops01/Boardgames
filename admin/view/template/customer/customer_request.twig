{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right"><a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
        <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-coupon').submit() : false;"><i class="fa fa-trash-o"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
      </div>
    <div class="panel-body">
    <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-coupon">
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
               {# <thead>
                    <tr>
                        <th><input type="checkbox" id="select-all"></th>
                        <th>Customer Name</th>
                        <th>Customer Email</th>
                        <th>Order ID</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Date Created</th>
                        <th>Date to complete</th>
                        <th>Assigned</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead> #}
               <thead>
                    <tr>
                        <th data-column="0">
                            <input type="checkbox" id="select-all">
                        </th>
                        <th data-column="1">Customer Name <span class="sort-icon">▼</span></th>
                        <th data-column="2">Customer Email <span class="sort-icon"></span></th>
                        <th data-column="3">Order ID <span class="sort-icon"></span></th>
                        <th data-column="4">Title <span class="sort-icon"></span></th>
                        <th data-column="5">Description <span class="sort-icon"></span></th>
                        <th data-column="6">Date Created <span class="sort-icon"></span></th>
                        <th data-column="7">Date to Complete <span class="sort-icon"></span></th>
                        <th data-column="8">Assigned <span class="sort-icon"></span></th>
                        <th data-column="9">Status <span class="sort-icon"></span></th>
                        <th>Action</th>
                    </tr>
                </thead>


                <tbody id="customers-block">
                     <tr class="filter">
				<td class="text-center"></td>
				<td class="text-left"><input type="text" id="search-name"  class="form-control" placeholder="Search by customer name"/></td>
				<td class="text-left"><input type="text" id="search-email"  class="form-control" placeholder="Search by customer email"/></td>
				<td class="text-left"><input type="text" id="search-order-id"  class="form-control" placeholder="Search by Order ID"/></td>
				<td></td>
				<td></td>
		       <td class="text-left cd-da">
                    <div class="input-group date">
                        <input type="date" id="search-date-created" placeholder="Search by date created" class="form-control" />
                    </div>
                </td>
                <td class="text-left cd-da">
                    <div class="input-group date">
                        <input type="date" id="search-date-complete" placeholder="Search by date complete" class="form-control" />
                    </div>
                </td>
				<td class="text-left">
				     <select class="form-control" name="assigned" id="search-assigned">
                		<option value="">Select an option</option>
                		<option value="Ruba">Ruba</option>
                		<option value="Vinay">Vinay</option>
                		
                   </select>
				</td>
				<td class="text-left">
				   {# <input type="text" id="search-status"  class="form-control" placeholder="Search by status"/> #}
				     <select class="form-control" name="status" id="search-status">
                		<option value="">Select an option</option>
                		<option value="All">Show All</option>
                		<option value="Pending">Pending</option>
                		<option value="Contact customer">Contact customer</option>
                		<option value="Email Sent">Email Sent</option>
                		<option value="Waiting for Response" >Waiting for Response</option> 
                		<option value="To be Processed">To be Processed</option>
                		<option value="Complete">Complete</option>
                   </select>
				</td>
			    <td>
                    <div class="button-container">
                        <span id="customer-search"><a class="btn btn-primary"><i class="fa fa-search"></i> Search</a></span>
                        <span id="customer-clear"><a class="btn btn-danger"> Clear filter</a></span>
                    </div>
                </td>
				
			  </tr>
                   {% for request in customer_request_details %}
                  
                        <tr>
                            <td><input type="checkbox" class="select-row" name="selected[]" value="{{ request.id }}" /></td>
                            <td>{{ request.customer_name }}</td>
                            <td>{{ request.customer_email }}</td>
                            <td> <a href="{{ request.order_id_url }}" data-toggle="tooltip" title="{{ button_edit }}">{{ request.order_id }}</a></td>
                            <td>{{ request.title }}</td>
                            <td>{{ request.description }}</td>
                            <td>{{ request.date_created }}</td>
                            <td>{{ request.date_to_created }}</td>
                            <td>{{ request.assigned }}</td>
                            <td>
                               
                                <a class="btn {% if request.status == 'Complete' %}btn-success{% else %}btn-danger{% endif %}">
                                  {{ request.status }}
                                </a>
                               
                            </td>
                            <td class="text-center">
                                <a href="{{ request.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary">
                                    <i class="fa fa-pencil"></i>
                                </a>
                            </td>
                        </tr>
                         
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </form>
    <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
    </div>
</div>

    </div>
  </div>
</div>
{{ footer }}
<style>
    td{
        word-wrap: break-word;
    }
    .button-container {
    display: flex;
    gap: 5px; 
    }
    .button-container span {
        display: inline-block;
    }
</style>
<script>
  $(document).ready(function () {
    let sortOrder = 1; // 1 for ascending, -1 for descending

    $("th").click(function () {
        const columnIndex = $(this).data("column");
        const tableBody = $(".table tbody");
        const rows = tableBody.find("tr").not(".filter").toArray(); // Exclude the filter row from sorting

        // Sort rows based on the clicked column
        rows.sort(function (a, b) {
            const cellA = $(a).find("td").eq(columnIndex).text().trim().toLowerCase();
            const cellB = $(b).find("td").eq(columnIndex).text().trim().toLowerCase();

            if (cellA < cellB) {
                return -1 * sortOrder;
            } else if (cellA > cellB) {
                return 1 * sortOrder;
            } else {
                return 0;
            }
        });

        // Append sorted rows back to the table
        $.each(rows, function (index, row) {
            tableBody.append(row);
        });

        // Toggle sort order
        sortOrder *= -1;

        // Reset all sort icons
        $(".sort-icon").text("▼");

        // Update the icon of the current column
        $(this).find(".sort-icon").text(sortOrder === 1 ? "▼" : "▲");
    });
});

$(document).ready(function() {
    $('#customer-search').on('click', function(e) {
        e.preventDefault();
        
        var baseUrl = '/admin/index.php?route=customer/customer_request&user_token={{user_token}}';
        
        var filterName = $('#search-name').val();
        var filterEmail = $('#search-email').val();
        var orderId = $('#search-order-id').val();
        var dateCreated = $('#search-date-created').val();
        var dateComplete = $('#search-date-complete').val();
        var assigned = $('#search-assigned').val();
        var status = $('#search-status').val();
        
        // Append filters to the base URL
        if (filterName) {
            baseUrl += '&filter_name=' + encodeURIComponent(filterName);
        }
        
        if (filterEmail) {
            baseUrl += '&filter_email=' + encodeURIComponent(filterEmail);
        }
        
        if (orderId) {
            baseUrl += '&filter_order_id=' + encodeURIComponent(orderId);
        }
        
        if (dateCreated) {
            baseUrl += '&filter_date_created=' + encodeURIComponent(dateCreated);
        }
        
        if (dateComplete) {
            baseUrl += '&filter_date_complete=' + encodeURIComponent(dateComplete);
        }
        
        if (assigned) {
            baseUrl += '&filter_assigned=' + encodeURIComponent(assigned);
        }
        
        if (status) {
            baseUrl += '&filter_status=' + encodeURIComponent(status);
        }
        
       
        
        // Redirect to the URL with the applied filters
        window.location.href = baseUrl;
    });
    
    
});

$(document).ready(function() {
    var baseUrl = '/admin/index.php?route=customer/customer_request&user_token={{user_token}}';
    var timer;

    $('#search-name').on('keyup', function() {
        clearTimeout(timer);
        
        timer = setTimeout(function() {
            var filterName = $('#search-name').val();
            console.log("filterName:", filterName);
            var url = baseUrl + '&filter_name=' + encodeURIComponent(filterName);
            window.location.href = url;
        }, 1000);  // 2000 milliseconds = 2 seconds
    });
    $('#search-email').on('keyup', function() {
        clearTimeout(timer);
        
        timer = setTimeout(function() {
            var filterEmail = $('#search-email').val();
          
            var url = baseUrl += '&filter_email=' + encodeURIComponent(filterEmail);
            window.location.href = url;
        }, 1000);  // 2000 milliseconds = 2 seconds
    });
    $('#search-order-id').on('keyup', function() {
        clearTimeout(timer);
        
        timer = setTimeout(function() {
           var orderId = $('#search-order-id').val();
            var url = baseUrl + '&filter_order_id=' + encodeURIComponent(orderId);
            window.location.href = url;
        }, 1000);  // 2000 milliseconds = 2 seconds
    });
    
     $('#customer-clear').on('click', function(e) {
        e.preventDefault(); // Prevent the default anchor behavior

        // Redirect to the base URL, effectively clearing all filters
        window.location.href = baseUrl;

        // Clear any form inputs if needed
        $('#search-name').val('');
        $('#search-email').val('');
        $('#search-order-id').val('');
        $('#search-date-created').val('');
        $('#search-date-complete').val('');
        $('#search-assigned').val('');
        $('#search-status').val('');

        console.log("Filters cleared. Redirecting to:", baseUrl);
    });
    
    
    
});
</script>