##########################################
# ❌ Do NOT block Google’s essential bots (AdsBot-Google, Googlebot, Mediapartners-Google)
# ✅ Safe to block AI scrapers, SEO crawlers, and social bots

# Removed: AdsBot-Google
SetEnvIfNoCase User-Agent "Amazonbot" bad_bot
SetEnvIfNoCase User-Agent "anthropic-ai" bad_bot
SetEnvIfNoCase User-Agent "Applebot" bad_bot
SetEnvIfNoCase User-Agent "Applebot-Extended" bad_bot
SetEnvIfNoCase User-Agent "AwarioRssBot" bad_bot
SetEnvIfNoCase User-Agent "AwarioSmartBot" bad_bot
