<script>
// Get the input element
var inputElement = document.getElementById('input-customerRegister');
if (inputElement) {
    inputElement.value = 1;
    inputElement.setAttribute('value', 1);
}

var hiddenInput = document.getElementById("hidden-input-customerRegister");
if (hiddenInput && hiddenInput.value === "0") {
    inputElement.setAttribute('max', '999');
}

var event_payment_code_element = document.getElementById('event_payment_code');
var event_payment_code = event_payment_code_element ? event_payment_code_element.value : 0;

var event_payment_code_id_element = document.getElementById('event_payment_code_id');
var event_payment_code_id = event_payment_code_id_element ? event_payment_code_id_element.value : 0;

function getDataFromInputFields(prefix) {
    var data = [];
    $('input[name^="' + prefix + '"]').each(function() {
        data.push($(this).val());
    });
    return data;
}

$(document).ready(function() {
    // Submit button click event handling
    $('#submitBtn').click(function(event) {
        event.preventDefault();
        
        // Validate the form
        var isValid = validateForm();

        // If the form is valid, proceed with form submission
        if (isValid) {
            $('#error-warning').text('').removeClass('alert alert-danger');

            // Submit the form
            $('#registrationForm').submit();

            addToCart(); // Ensure this function is defined elsewhere

            // Get form data using FormData
            var formData = new FormData($("#registrationForm")[0]);

            // Get table data
            var tableData = [];
            $("#tableBody tr").each(function(index, row) {
                var registerName = $(row).find('input[name^="registerName"]').val();
                var product_id = $(row).find('select[name^="product_id"]').val();

                if (registerName && product_id) {
                    tableData.push({ registerName: registerName, product_id: product_id });
                }
            });

            // Get the register_count value
            var register_count = inputElement ? inputElement.value : 0;

            // Append register_count to formData
            formData.append("register_count", register_count);

            // Add table data to form data
            formData.append("tableData", JSON.stringify(tableData));

            // Send AJAX request
            $.ajax({
                type: "POST",
                url: "{{ your_ajax_endpoint }}", // Specify your backend endpoint
                data: formData,
                contentType: false,
                processData: false,
                success: function(response) {
                    console.log("Success:", response);
                },
                error: function(error) {
                    console.error("Error:", error);
                }
            });
        }
    });

    function validateForm() {
        var isValid = true;

        // Clear previous error messages
        $("#error-warning").empty().removeClass('alert alert-danger');

        $("#tableBody tr").each(function(index, row) {
            var registerName = $(row).find('input[name^="registerName"]').val().trim();
            var product_id = $(row).find('select[name^="product_id"]').val();
            var rowIsValid = true;

            if (!registerName) {
                $('#error-warning').text('Error: Please fill the Register Name field.');
                $('#error-warning').addClass('alert alert-danger');
                rowIsValid = false;
            }

            if (!product_id) {
                $('#error-warning').text('Error: Please choose the game from the game list.');
                $('#error-warning').addClass('alert alert-danger');
                rowIsValid = false;
            }

            if (!rowIsValid) {
                isValid = false;
                return false; // Exit the .each loop
            }

            $('select[name="product_id[]"]').each(function() {
                var selectedOption = $(this).find('option:selected');
                if (selectedOption.length > 0) {
                    var capacity = parseInt(selectedOption.data('capacity')) || 0;
                    var existingUsers = parseInt(selectedOption.data('existing-users')) || 0;
                    var quantity = parseInt(inputElement ? inputElement.value : 0);
                    var remainuser = capacity - existingUsers;

                    if (remainuser > capacity ) {
                        $('#error-warning').text('Error: Game exceeds its max limit (' + capacity + '). Please choose another game.');
                        $('#error-warning').addClass('alert alert-danger');
                        isValid = false;
                    }
                }
            });
        });

        var inputValue = $('#input-customerRegister').val();
        if (!inputValue.trim()) {
            $('#error-warning').text('Error: Number of Persons to register field value cannot be empty.');
            $('#error-warning').addClass('alert alert-danger');
            isValid = false;
        }

        return isValid;
    }
});
    
    function addToCart() {
    var isValid = true;

    // Collect necessary data
    var product_id = document.getElementById('ticket_product_id')?.value || '';
    var event_venue = document.getElementById('event_venue')?.value || '';
    var event_venue_id = document.getElementById('product_option_event_venue_id')?.value || '';
    var event_registeruse_id = document.getElementById('product_option_event_registeruse_id')?.value || '';
    var quantity = document.getElementById('input-customerRegister')?.value || 0;
    var event_payment_code = document.getElementById('event_payment_code')?.value || '';
    var event_payment_code_id = document.getElementById('event_payment_code_id')?.value || '';
    var events_name = document.getElementById('events_name')?.value || '';
    var event_name_id = document.getElementById('product_option_event_name_id')?.value || '';
    var product_option_event_product_name = document.getElementById('product_option_event_product_name')?.value || '';
    var registeruser_count_id = document.getElementById('registeruser_count_id')?.value || '';
    var event_time = document.getElementById('event_time')?.value || '';
    var event_time_id = document.getElementById('event_time_id')?.value || '';

    // Collect register names
    var registerNameInputs = document.querySelectorAll('input[name="registerName[]"]');
    var registerNames = Array.from(registerNameInputs)
        .map(input => input.value.trim())
        .filter(value => value !== '');

    // Collect selected product IDs and names
    var event_product_id_selects = document.querySelectorAll('select[name="product_id[]"]');
    var event_product_ids = [];
    var product_names = [];

    event_product_id_selects.forEach(function(select) {
        var selectedOption = select.options[select.selectedIndex];
        if (selectedOption) {
            var value = selectedOption.value.trim();
            if (value) {
                event_product_ids.push(value);
                var productName = selectedOption.getAttribute('data-productname');
                if (productName) {
                    product_names.push(productName);
                }
            }
        }
    });

    // Format product name list
    var event_product_name_list = product_names.join(',').replace(/,\s+/g, ',');

    // Combine register names into a list
    var registerNamelist = registerNames.join(', ');

    // Create options payload
    var option = {};
    option[event_name_id] = events_name;
    option[event_venue_id] = event_venue;
    option[event_time_id] = event_time;
    option[event_registeruse_id] = registerNamelist;
    option[product_option_event_product_name] = event_product_name_list;
    option[registeruser_count_id] = quantity;

    // Create payload
    var payload = {
        product_id: product_id,
        quantity: quantity,
        option: option
    };

    // Send AJAX request
    var xhr = new XMLHttpRequest();
    xhr.open('POST', '/index.php?route=checkout/cart/add', true);
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.onreadystatechange = function() {
       // if (xhr.readyState === 4) {
            if (xhr.status === 200) {
                // Handle success
                var response = JSON.parse(xhr.responseText);
                if (!response.error) {
                    window.location.href = '/index.php?route=checkout/cart';
                }
            } else {
                // Handle error
                var response = JSON.parse(xhr.responseText);
                var errorMessage = '';

                if (response.error && response.error.option) {
                    for (var key in response.error.option) {
                        if (response.error.option[key]) {
                            errorMessage += response.error.option[key] + '<br>';
                        }
                    }
                } else {
                    errorMessage = 'An error occurred while adding to cart.';
                }

                document.getElementById('error-warning').innerHTML = errorMessage;
            }
       // }
    };

    xhr.send(JSON.stringify(payload));

    return isValid;
}


$('#account .form-group[data-sort]').detach().each(function() {
	if ($(this).attr('data-sort') >= 0 && $(this).attr('data-sort') <= $('#account .form-group').length) {
		$('#account .form-group').eq($(this).attr('data-sort')).before(this);
	}

	if ($(this).attr('data-sort') > $('#account .form-group').length) {
		$('#account .form-group:last').after(this);
	}

	if ($(this).attr('data-sort') == $('#account .form-group').length) {
		$('#account .form-group:last').after(this);
	}

	if ($(this).attr('data-sort') < -$('#account .form-group').length) {
		$('#account .form-group:first').before(this);
	}
});

$('input[name=\'customer_group_id\']').on('change', function() {
	$.ajax({
		url: 'index.php?route=account/event_register/customfield&customer_group_id=' + this.value,
		dataType: 'json',
		success: function(json) {
			$('.custom-field').hide();
			$('.custom-field').removeClass('required');

			for (i = 0; i < json.length; i++) {
				custom_field = json[i];

				$('#custom-field' + custom_field['custom_field_id']).show();

				if (custom_field['required']) {
					$('#custom-field' + custom_field['custom_field_id']).addClass('required');
				}
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

