$(document).ready(function () {
    // Function to update table rows
    function updateTableRows(numToShow) {
        // Remove existing rows
        $('#tableBody').empty();

        // Append new rows based on numToShow
        for (var i = 1; i <= numToShow; i++) {
            $('#tableBody').append(`
                <tr>
                    <td>
                        <div class="form-group">
                            <input type="text" name="registerName[]" value="" id="userReg_name_${i}" class="form-control" />
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                           <select name="product_id[]" id="input-product-id_${i}" class="form-control">
                                <option value="">{{ text_select }}</option>
                                {% for product in products %}
                                    {% if product.product_id != '6394' %}
                                        <option data-existing-users="{{ product.existing_registered_users }}" data-capacity="{{ product.maxplayer }}" data-productname="{{ product.name }}" value="{{ product.product_id }}" id="event_product_id">{{ product.name }} ({{ product.existing_registered_users }}/{{ product.maxplayer }})</option>
                                    {% else %}
                                        <option data-existing-users="{{ product.existing_registered_users }}" data-capacity="{{ openRegister }}" data-productname="{{ product.name }}" value="{{ product.product_id }}" id="event_product_id">{{ product.name }} ({{ openRegister }})</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                    </td>
                </tr>
            `);
        }
    }

    // Show 1 row by default
    updateTableRows(1);

    // Show/hide rows based on `#input-customerRegister` value when the input changes
    $('#input-customerRegister').on('input', function () {
        var inputValue = $(this).val().trim(); // Trim whitespace from input
        var maxAllowed = parseInt($(this).attr('max'), 10) || 0; // Parse max attribute value
        var eventmaxregister = parseInt($('#hidden-input-customerRegister').val(), 10) || 0; // Hidden max value

        // Validate input
        if (inputValue === '') {
            // Show 1 row and display an error message
            updateTableRows(1);
            $('#error-warning').text('Error: Number of Persons to register field value cannot be empty');
            $('#error-warning').addClass('alert alert-danger');
            return;
        }

        var numToShow = parseInt(inputValue, 10);

        if (isNaN(numToShow) || numToShow <= 0) {
            // Handle invalid or zero values
            updateTableRows(1);
            $('#error-warning').text('Error: Please enter a valid number of persons to register.');
            $('#error-warning').addClass('alert alert-danger');
            return;
        }

        // Check against maximum allowed
        if (numToShow > maxAllowed) {
            updateTableRows(0);
            var errorMessage = `Exceeds the maximum number of register users permitted (${maxAllowed})`;
            $('#error-warning').text('Error: ' + errorMessage);
            $('#error-warning').addClass('alert alert-danger');
            return;
        }

        // Check against event-specific maximum registration
        if (eventmaxregister !== 0 && numToShow > eventmaxregister) {
            updateTableRows(0);
            var eventErrorMessage = `Exceeds the maximum number of register users permitted (${eventmaxregister})`;
            $('#error-warning').text('Error: ' + eventErrorMessage);
            $('#error-warning').addClass('alert alert-danger');
            return;
        }

        // Clear error and show rows
        $('#error-warning').text('');
        $('#error-warning').removeClass('alert alert-danger');
        $('#tableBody').show();

        // Update rows
        updateTableRows(numToShow);
    });
});

$(document).ready(function () {
    var eventsId = $('#events_id').val();

    if (eventsId) {
        $.ajax({
            url: 'index.php?route=account/event_register/index',
            type: 'POST',
            data: { events_id: eventsId },
            dataType: 'json',
            success: function (response) {
                if (response.success) {
                    $('#eventName').text(response.event_name || '');
                    $('#eventDate').text(response.event_date || '');
                } else if (response.error) {
                    $('#eventDetails').html('<p class="text-danger">' + response.error + '</p>');
                }
            },
            error: function (xhr, status, error) {
                console.error('AJAX Error:', error);
                $('#eventDetails').html('<p class="text-danger">An error occurred while fetching event data. Please try again.</p>');
            }
        });
    }
});
</script>

