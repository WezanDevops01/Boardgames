<script>
document.addEventListener('DOMContentLoaded', function () {
    const eventDetails = {
        title: '{{ event.name }}',
        startDate: '{{ event.calender_start_date }}T{{ event.calender_start_time }}00', // Format: YYYY-MM-DDTHH:MM:SS
        endDate: '{{ event.calender_end_date }}T{{ event.calender_end_time }}00',
        details: `{{ event.description }}`,
        location: '{{ event.venue }}',
    };

    // Construct the Google Calendar event link
    const eventLink = `https://www.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(eventDetails.title)}&dates=${eventDetails.startDate}/${eventDetails.endDate}&details=${encodeURIComponent(eventDetails.details)}&location=${encodeURIComponent(eventDetails.location)}`;

    // Update the href attribute of the button with the generated link
    document.querySelector('a[href="YOUR_GOOGLE_CALENDAR_EVENT_LINK"]').href = eventLink;
});
</script>
