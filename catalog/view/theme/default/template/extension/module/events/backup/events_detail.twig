<div class="container">
	<ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
            <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
	</ul>
	
	<div class="row">{{ column_left }}
        {% if column_left and column_right %}
            {% set class = 'col-sm-6' %}
        {% elseif column_left or column_right %}
            {% set class = 'col-sm-9' %}
        {% else %}
            {% set class = 'col-sm-12' %}
        {% endif %}
		
		<div id="content" class="{{ class }}">{{ content_top }}
			<div class="row">

		        {% if column_left and column_right %}
		            {% set class = 'col-sm-6' %}
		        {% elseif column_left or column_right %}
		            {% set class = 'col-sm-6' %}
		        {% else %}
		            {% set class = 'col-sm-6' %}
		        {% endif %}
				<div class="text-center">
					<h1 class="title page-title"><span>{{ event.name }}</span></h1>
				</div>
				<div class="event-details-full-section">
				<div class="col-md-12 col-sm-12 col-lg-12 col-xs-12 eventd-image-section">
					{% if thumb or images %}
						<ul class="thumbnails">
						  	{% if thumb is defined %}
						  		<li><a class="thumbnail" href="{{ popup }}" title="{{ heading_title }}"><img src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" /></a></li>
						  	{% endif %}
							{#
						  	{% if images is defined %}
						  		{% for image in images %}
						  			<li class="image-additional"><a class="thumbnail" href="{{ image.popup }}" title="{{ heading_title }}"> <img src="{{ image.thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" /></a></li>
						  		{% endfor %}
						  	{% endif %}
							#}
						</ul>
					{% endif %}
				</div>

		        {% if column_left and column_right %}
		            {% set class = 'col-sm-6' %}
		        {% elseif column_left or column_right %}
		            {% set class = 'col-sm-6' %}
		        {% else %}
		            {% set class = 'col-sm-6' %}
		        {% endif %}

				<div class="col-md-12 col-sm-12 col-lg-12 col-xs-12 eventd-content-section">
					<div class='content-section-d'>
					<div class="description">  
						{% if event.start_date is defined %}
						    {% if event.start_date == event.end_date %}
						  	    <span><strong>{{ text_date }}</strong></span> {{ event.start_date }} ({{ event.start_time }} - {{ event.end_time }})<br />
						  	{% else %}
    						  	{% if event.start_date is defined %}
    						  	    <span><strong>{{ text_start_date }}</strong></span> {{ event.start_date }} {{ event.start_time }}<br />
    						  	{% endif %}    
    						  	{% if event.end_date is defined %}
    						  	    <span><strong>{{ text_end_date }}</strong></span> {{ event.end_date }} {{ event.end_time }}<br />
    						    {% endif %}
    						{% endif %}   
						{% endif %}
		
						{% if event.venue is defined %}
						  	<span><strong>{{ text_venue }}</strong></span> <span class="mapThis" place="{{ event.venue }}/@{{ event.latitude }},{{ event.longitude }}" zoom="17">{{ event.venue }}</span><br />
						{% endif %}
				    </div>
		

                     <div class="row mt-5" style="margin: 15px auto;">
                		{#<div id="product-info-table-container"  style="max-width: 800px;  overflow-x: scroll;"> #}
                		    <div id="product-info-table-container" style="max-height: 400px;overflow: scroll;">
                			<table id="product-info-table" class="table table-bordered" >
                				<tbody>
                					<tr>
                					  <th colspan="2">Game</th>
                					   <th>Registrations</th>
                					   <th>Length</th>
                					   <th>Game Type</th>
                						<th>Difficulty</th>
                						<th>Start Time</th>
                						<th>Taught by</th>
                						<th>Video</th>
                					</tr>
                						{% for event in events %}
                					<tr>                                     
                							<td colspan="2">{{ event.name }}</td>
                							 {% if event.product_id != '6394' %}
                							<td>{{ event.existing_registered_users }} / {{ event.maxplayer }}</td>
                							{% endif %}
                							<td>{{ event.length }}</td>
                							<td>{{ event.game_type }}</td>
                							<td>{{ event.difficulty }}</td>
                							<td>{{ event.start_time }}</td>
                							<td>{{ event.taught_by }}</td>  
                							 <td>{% if event.video %}
                                                <a class="popup-video btn" href="{{ event.video }}">View</a>
                                             {% endif %}</td>  
                					</tr>
                						{% endfor %}
                				</tbody>
                			</table>
                		</div>
                	</div>

					<div class="price">
					    <hr>
					    <strong>{{ text_product }}</strong>
						{% if products is not empty %}
							{% set count = 1 %}
							{% for product in products %}
							{% if product.name != 'None' and product.product_id != '6394' %}
						  		<br><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ count }}: 
										<a href="{{ product.href }}" target="_blank">{{ product.name }} ({{ product.existing_registered_users }}/{{ product.maxplayer }})</a> 
						  		</span>
								{% set count = count+1 %}
								{% endif %}
							{% endfor %}
						{% else %}
						  	<span>{{ text_no_product }}</span>
						{% endif %}
						{% if(count<=0) %}
						  	<span>{{ text_no_product }}</span>
						{% endif %}
				     </div>
					
				     <hr>
				     	{% if cost > 0 %}
				     <div class="Event-ticket-fee" style="margin: 0px 0px 10px; font-size: 2.5rem;"><p><b>The entry fee for this event:</b> <span style="color:red;"><b>${{cost}}</b></span></p></div>
				      {% else %}
				      <div class="Event-ticket-fee" style="margin: 0px 0px 10px; font-size: 2.5rem;"><p><b>The entry fee for this event:</b> <span style="color:green;"><b>Free</b></span></p></div>
				      	{% endif %}
				    <div class="registration-groups"> 
    					{% if event.expired=='' %}
    				    <div class="register-button">
    				         <a href="{{ event.href }}" class="btn">Register</a>
    				    </div> 
    					{% else %}
    					<div class="register-button">
    				         <a class="btn btn-warning">Sorry Event Registration Closed</a>
    				    </div> 
    					{% endif %}
    					<div class="registration-count">
    					<p>Registration : {{ sum_of_existing_registered_users }}/{{ eventmaxRegister }}</p>
    					</div>
        				<a href="YOUR_GOOGLE_CALENDAR_EVENT_LINK" target="_blank" class="btn" style="margin: 0px 0px 0px 20px;">  Add to Calendar    </a> 
					</div>
				    {% if is_logged %}
				        <span></span>
				    {% else %}
				        <span>Login to your account for event registrations</span>
				    {% endif %}
				     
				     <hr>
				     
				     <ul class="nav nav-tabs">
				        {% if event.description is defined %}
							<li class="active"><a href="#tab-description" data-toggle="tab">{{ tab_description }}</a></li>
						{% endif %}
						{% if contact_info is defined %}
							<li><a href="#tab-contact" data-toggle="tab">{{ tab_contact }}</a></li>
						{% endif %}
					
				    </ul>
					
					<div class="tab-content">
						{% if event.description is defined %}
							<div class="tab-pane active" id="tab-description">{{ event.description }}</div>
						{% endif %}
						
						{% if contact_info is defined %}
							<div class="tab-pane" id="tab-contact">
								{% if contact_info.contact_name!='' %}
									
									<div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
									      <strong>{{ text_contact_name }}</strong>
									</div>
									<div class="col-lg-10 col-md-10 col-sm-12 col-xs-12">
									      {{ contact_info.contact_name }}
									</div>
									<div style="clear:both;">&nbsp;</div>
								
								{% endif %}
								
								{% if contact_info.contact_phone!='' %}
								
									<div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
										<strong>{{ text_contact_phone }}</strong>
									</div>
									<div class="col-lg-10 col-md-10 col-sm-12 col-xs-12">
										{{ contact_info.contact_phone }}
									</div>
									<div style="clear:both;">&nbsp;</div>
									
								{% endif %}

								{% if contact_info.contact_fax!='' %}
								
									<div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
										<strong>{{ text_contact_fax }}</strong>
									</div>
									<div class="col-lg-10 col-md-10 col-sm-12 col-xs-12">
										{{ contact_info.contact_fax }}
									</div>
									<div style="clear:both;">&nbsp;</div>
								
								{% endif %}

								{% if contact_info.contact_email!='' %}
								
									<div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
										<strong>{{ text_contact_email }}</strong>
									</div>
									<div class="col-lg-10 col-md-10 col-sm-12 col-xs-12">
										{{ contact_info.contact_email }}
									</div>
									<div style="clear:both;">&nbsp;</div>
								
								{% endif %}

								{% if contact_info.contact_add!='' %}
								
									<div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
										<strong>{{ text_contact_add }}</strong>
									</div>
									<div class="col-lg-10 col-md-10 col-sm-12 col-xs-12">
										{{ contact_info.contact_add }}
									</div>
									<div style="clear:both;">&nbsp;</div>
								
								{% endif %}
							</div>
						{% endif %}
					</div>
				      
				      
				     <div class="review">
						<hr>
						<!-- AddThis Button BEGIN -->
						<div class="addthis_toolbox addthis_default_style"><a class="addthis_button_facebook_like" fb:like:layout="button_count"></a> <a class="addthis_button_tweet"></a> <a class="addthis_button_pinterest_pinit"></a> <a class="addthis_counter addthis_pill_style"></a></div>
						<script type="text/javascript" src="//s7.addthis.com/js/300/addthis_widget.js#pubid=ra-515eeaf54693130e"></script> 
						<!-- AddThis Button END --> 
				    </div>
				    
				    {#
				    {% if video is defined and video!='' %}
						<div class="price event-video-container">
						  <h3>Video</h3>
						  <div class="">
						    <iframe width="100%" height="345"
						    src="https://www.youtube.com/embed/{{ video }}" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen>
						    </iframe>
						  </div>
						  
						</div>
				    {% endif %}
					#}
					</div>
				      
				</div>
				</div>
			</div>
		{{ content_bottom }}</div>
		
	{{ column_right }}</div>
</div>
