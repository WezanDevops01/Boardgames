<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/1999/REC-html401-19991224/strict.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>{{ title }}</title>
</head>
<body style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #000000;">
<div style="width: 680px;">
 <table width="100%" border="0" cellspacing="0" cellpadding="0">

  <!-- IMAGE ROW (TOP CENTER) -->
  {% if image %}
  <tr>
    <td align="center" style="padding-bottom: 20px;">
      <a href="{{ store_url }}">
        <img src="{{ image }}"
             alt="{{ store_name }}"
             width="70%"
             style="border:0;display:block;margin:0 auto; " />
      </a>
    </td>
  </tr>
  {% endif %}

  <!-- CONTENT ROW -->
  <tr>
    <td valign="top">
      <p style="margin-top:0;margin-bottom:20px;">{{ text_greeting }}</p>
      <p style="margin-top:0;margin-bottom:20px;">{{ text_from }}</p>

      {% if message %}
        <p style="margin-top:0;margin-bottom:20px;"><strong>{{ text_message }}</strong></p>
        <p style="margin-top:0;margin-bottom:20px;">{{ message }}</p>
      {% endif %}

      <p style="margin-top:0;margin-bottom:20px;">{{ text_redeem }}</p>
      <p style="margin-top:0;margin-bottom:20px;">
        <a href="{{ store_url }}">{{ store_url }}</a>
      </p>
      <p style="margin-top:0;margin-bottom:20px;">{{ text_footer }}</p>
    </td>
  </tr>

</table>

</div>
</body>
</html>
